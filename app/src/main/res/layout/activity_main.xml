<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="監視対象アプリのパッケージ名"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editPackage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="com.google.android.apps.kids.familylink" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="判定条件式(&amp;&amp;=かつ, ||=または, !=でない, 文字列は&quot;で囲む)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editCondition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="6"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:hint="&quot;柏市&quot; &amp;&amp; !&quot;新柏&quot;" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="監視間隔(分)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editInterval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="15" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="監視を開始" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="監視を停止" />

    <Button
        android:id="@+id/btnTestCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="今すぐ1回テスト実行" />

    <Button
        android:id="@+id/btnStopAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="鳴動中のアラームを止める" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="状態: 停止中"
        android:textSize="16sp" />

</LinearLayout>
